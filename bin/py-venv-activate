DEPLOY_DIR="$(cd -- "$(dirname "${BASH_SOURCE}")" ; cd .. > /dev/null 2>&1 && pwd -P)"

cd $DEPLOY_DIR
./bin/env/python-setup

VENV_DIR=$DEPLOY_DIR/.venv

echo "# using (cached) venv in $VENV_DIR"

# Reuse the cached venv only when it still works. A venv whose files were
# removed underneath it (systemd-tmpfiles cleaning /tmp after 10 days removes
# the files but leaves the directory skeleton; a python removed by the tool
# versions manager leaves a dangling bin/python) still has bin/activate, but
# pip then fails with "No module named 'pip._internal.cli.main'".
if [ -d ${VENV_DIR} ] \
  && ! ( ${VENV_DIR}/bin/python -c 'import pip._internal.cli.main' > /dev/null 2>&1 \
         && [ -x ${VENV_DIR}/bin/ansible-playbook ] ); then
  echo "# venv in $VENV_DIR is broken or incomplete, recreating it"
  rm -rf ${VENV_DIR}
fi

if [ ! -f ${VENV_DIR}/bin/activate ]; then
  python3 -m venv ${VENV_DIR}
fi

source ${VENV_DIR}/bin/activate

if [ -f ${DEPLOY_DIR}/ansible-requirements.txt ]; then
  pip install -q -r ${DEPLOY_DIR}/ansible-requirements.txt
fi

# vi: ft=sh
